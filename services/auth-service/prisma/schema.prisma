generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  role       String   @db.VarChar(50)
  full_name  String?  @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  avatar_url String?  @db.Text
  status     String   @default("pending_verification") @db.VarChar(50)
  fcm_token        String?  @db.Text
  farm_name        String?  @db.VarChar(255)
  farm_address     String?  @db.Text
  farm_size_ha     Float?
  commodities      Json?    @default("[]")
  farm_description String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz
  farm_lands       FarmLand[]
  harvest_records  HarvestRecord[]
  saved_addresses  SavedAddress[]

  @@map("users")
}

model FarmLand {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmer_id         String   @db.Uuid
  name              String   @db.VarChar(255)
  location_province String   @db.VarChar(100)
  location_city     String   @db.VarChar(100)
  location_district String   @db.VarChar(100)
  full_address      String   @db.Text
  area_ha           Float
  soil_type         String?  @db.VarChar(100)
  status            String   @default("active") @db.VarChar(50) // active | fallow | rented
  current_crop      String?  @db.VarChar(100)
  notes             String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz
  user              User     @relation(fields: [farmer_id], references: [id], onDelete: Cascade)
  harvest_records   HarvestRecord[]

  @@index([farmer_id])
  @@map("farm_lands")
}

model HarvestRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmer_id     String   @db.Uuid
  land_id       String   @db.Uuid
  crop_name     String   @db.VarChar(100)
  quantity      Float
  unit          String   @db.VarChar(50)
  harvest_date  DateTime @db.Date
  quality_grade String   @db.VarChar(10) // A | B | C
  notes         String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz
  user          User     @relation(fields: [farmer_id], references: [id], onDelete: Cascade)
  land          FarmLand @relation(fields: [land_id], references: [id], onDelete: Cascade)

  @@index([farmer_id])
  @@index([land_id])
  @@map("harvest_records")
}

model SavedAddress {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  label          String   @db.VarChar(100)
  recipient_name String   @db.VarChar(255)
  phone_number   String   @db.VarChar(50)
  province       String   @db.VarChar(100)
  city           String   @db.VarChar(100)
  district       String   @db.VarChar(100)
  full_address   String   @db.Text
  postal_code    String   @db.VarChar(20)
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("saved_addresses")
}

model Commodity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  @@map("commodities")
}
